<mxfile host="app.diagrams.net" modified="2026-03-08T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="architecture-overview" name="1. システム全体概要">
    <mxGraphModel dx="2500" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- タイトル -->
        <mxCell id="title1" value="AutoTraderV4 アーキテクチャ全体概要" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== 読み方ガイド ===== -->
        <mxCell id="guide1" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】AutoTraderV4の全体構造を1枚で把握するための地図です。&#xa;&#xa;【読む順番】上から下へ読んでください:&#xa;  上段: 実行基盤 = 「どこで動くか」（ライブ or バックテスト）&#xa;  中段: トレードロジック = 「どう判断するか」（シグナル生成・ポジション管理）&#xa;  下段: 制約・計算・設定 = 「何を使って判断するか」&#xa;&#xa;【色の意味】&#xa;  青(水色): 外部インターフェース・コア基盤&#xa;  オレンジ: トレードロジック（一番重要な部分）&#xa;  赤(ピンク): ガード・制約（安全装置）&#xa;  緑: データ処理・指標計算&#xa;  紫: 設定・リスク管理&#xa;&#xa;【最も重要なポイント】&#xa;  ライブトレードもバックテストも、中段の「共通トレードロジック」を&#xa;  そのまま使います。つまりバックテストで検証した結果が&#xa;  そのままライブトレードの成績に直結します。&#xa;&#xa;【具体例: USDJPYでBUYシグナルが出るまでの流れ】&#xa;  MT5(またはCSV) → ローソク足取得 → UnifiedTradeBot&#xa;  → SignalPipeline(6ステップ) → BUY/SELL/HOLDを返す&#xa;  → ライブならMT5に注文、バックテストなら仮想ポジション作成" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1200" y="310" width="560" height="370" as="geometry"/>
        </mxCell>

        <!-- ===== 実行基盤レイヤー ===== -->
        <mxCell id="exec_layer" value="実行基盤レイヤー — 「どこで動くか」" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1140" height="220" as="geometry"/>
        </mxCell>

        <!-- ライブトレード -->
        <mxCell id="live_group" value="ライブトレード (live/)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="exec_layer">
          <mxGeometry x="20" y="40" width="520" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="live_engine" value="LiveTradingEngine&#xa;engine.py&#xa;━━━━━━━━━━━━&#xa;MT5からリアルタイムで&#xa;価格を取得し、自動で&#xa;売買注文を出すエンジン" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="live_group">
          <mxGeometry x="10" y="30" width="170" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="engine_mgr" value="EngineManager&#xa;engine_manager.py&#xa;━━━━━━━━━━━━&#xa;複数の通貨ペア(USDJPY,&#xa;EURJPY等)を同時に管理&#xa;する司令塔" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="live_group">
          <mxGeometry x="190" y="30" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="live_services" value="サービス群&#xa;━━━━━━━━━━━━&#xa;DataFeed: データ取得&#xa;OrderService: 注文送信&#xa;PositionSync: MT5と同期&#xa;EventPublisher: WebUI通知&#xa;TickEntryOptimizer: 有利な&#xa;  タイミングでエントリー" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="live_group">
          <mxGeometry x="360" y="30" width="150" height="120" as="geometry"/>
        </mxCell>

        <!-- バックテスト -->
        <mxCell id="bt_group" value="バックテスト (backtest/)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="exec_layer">
          <mxGeometry x="560" y="40" width="560" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="bt_runner" value="BacktestRunner&#xa;runner.py&#xa;━━━━━━━━━━━━&#xa;過去データを使って&#xa;「もし取引していたら&#xa;どうなったか」を&#xa;シミュレーション" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="bt_group">
          <mxGeometry x="10" y="30" width="170" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="year_runner" value="run_unified_year&#xa;year_runner.py&#xa;━━━━━━━━━━━━&#xa;年ごとに独立して&#xa;シミュレーション実行&#xa;(2020年、2021年...)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="bt_group">
          <mxGeometry x="195" y="30" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="simulator" value="TradeSimulator&#xa;simulator.py&#xa;━━━━━━━━━━━━&#xa;仮想的にポジションを&#xa;開閉して損益を計算&#xa;する疑似取引エンジン" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="bt_group">
          <mxGeometry x="370" y="30" width="170" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== 共通トレードロジックレイヤー ===== -->
        <mxCell id="logic_layer" value="共通トレードロジックレイヤー — 「どう判断するか」（ライブ・バックテスト共通）" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1140" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="tradebot" value="UnifiedTradeBot&#xa;trade_bot.py&#xa;━━━━━━━━━━━━━━━━━━━&#xa;【頭脳】全ての判断の起点。&#xa;「今、買うべきか・売るべきか・&#xa;何もしないか」を決める。&#xa;内部でSignalPipelineを呼び出す。" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="logic_layer">
          <mxGeometry x="20" y="40" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="pipeline" value="SignalPipeline&#xa;pipeline_pkg/pipeline.py&#xa;━━━━━━━━━━━━━━━━━━━&#xa;【6段階のフィルター】&#xa;1. リスクチェック（取引可能か？）&#xa;2. 時間足評価（各TFの方向は？）&#xa;3. コンセンサス（全TF総合判定）&#xa;4. エッジ評価（方向性に確信あるか？）&#xa;5. フィルター（危険な状況でないか？）&#xa;6. サイジング（何ロットで入るか？）&#xa;→ 全て通過して初めてBUY/SELL発行" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="logic_layer">
          <mxGeometry x="320" y="40" width="280" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="position_mgr" value="PositionManager&#xa;risk/position_manager.py&#xa;━━━━━━━━━━━━━━━━━━━&#xa;【保有中のポジション管理】&#xa;「いつ決済するか」を判断:&#xa;• SL/TP到達で即決済&#xa;• 停滞・時間制限で損切り&#xa;• シグナル反転で利確&#xa;• トレーリングストップ追従&#xa;10個のチェックを順番に実行" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="logic_layer">
          <mxGeometry x="620" y="40" width="250" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="scoring_brief" value="スコアリング (scoring/)&#xa;━━━━━━━━━━━━━━━━━━━&#xa;各時間足(M5,M15,H1等)で&#xa;RSI・MACD・トレンド等の&#xa;指標を見て「買い寄り」か&#xa;「売り寄り」かをスコア化" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="logic_layer">
          <mxGeometry x="890" y="40" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="mode_sel" value="ModeSelector&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;UNIVERSALモード固定。&#xa;どのTFを「主力」「エントリー」&#xa;「確認」「管理」として使うかを決定" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="logic_layer">
          <mxGeometry x="20" y="165" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== 制約・ガードレイヤー ===== -->
        <mxCell id="guard_layer" value="制約・ガードレイヤー — 「安全装置」" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1140" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="hard_guard" value="HardGuard（絶対禁止）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;以下の場合は問答無用でブロック:&#xa;• 証拠金不足&#xa;• 1日の損失上限到達&#xa;• ポジション数上限&#xa;• 取引禁止時間帯&#xa;• 重要経済指標の直前" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="guard_layer">
          <mxGeometry x="20" y="35" width="250" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="soft_guard" value="SoftGuard（ペナルティ蓄積）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;「やや危険」な状況にペナルティを&#xa;加算し、合計0.8以上でブロック:&#xa;• スプレッドが広い (+0.3)&#xa;• ボラティリティが低い (+0.2)&#xa;• 連敗中 (+0.2)&#xa;→ 複合的なリスクを検知" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="guard_layer">
          <mxGeometry x="290" y="35" width="260" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="risk_mgr_box" value="RiskManager（多層防御）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;大損を防ぐ5重の安全装置:&#xa;1. クールダウン（連敗後の休憩）&#xa;2. 日次損失制限&#xa;3. 日次トレード件数制限&#xa;4. サーキットブレーカー&#xa;5. 急速DD検知（口座急落時停止）" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="guard_layer">
          <mxGeometry x="570" y="35" width="260" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="filters_brief" value="フィルター群&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;Pipeline Step5で適用:&#xa;• 時間帯フィルター&#xa;• レジーム別フィルター&#xa;• トレンド強度制限&#xa;• MACD方向チェック&#xa;→ 計14個の個別フィルター" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="guard_layer">
          <mxGeometry x="850" y="35" width="260" height="125" as="geometry"/>
        </mxCell>

        <!-- ===== 指標計算レイヤー ===== -->
        <mxCell id="calc_layer" value="指標計算レイヤー — 「何を見て判断するか」" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1140" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="tech_calc" value="テクニカル指標&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;SMA/EMA（移動平均線）&#xa;RSI（買われすぎ/売られすぎ）&#xa;MACD（トレンドの強さ/方向）&#xa;ATR（値動きの幅＝ボラティリティ）&#xa;ボリンジャーバンド/ストキャスティクス" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="calc_layer">
          <mxGeometry x="20" y="35" width="280" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="features" value="特徴量&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;RegimeDetector: 今の相場は&#xa;  TREND(方向あり)/RANGE(横ばい)/&#xa;  LOW_VOL(静か) のどれか判定&#xa;ダイバージェンス: 価格と指標のズレ検出" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="calc_layer">
          <mxGeometry x="320" y="35" width="280" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="precompute" value="PrecomputeEngine&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;バックテスト高速化のため&#xa;全指標を事前に一括計算して&#xa;Parquetファイルにキャッシュ" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="calc_layer">
          <mxGeometry x="620" y="35" width="230" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== 設定管理レイヤー ===== -->
        <mxCell id="config_layer" value="設定管理レイヤー — 「パラメータをどこで管理するか」" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1140" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="unified_config" value="UnifiedBotConfig&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;トレード判断の設定:&#xa;• consensus_threshold (9.0)&#xa;• 使用する時間足 (8TF)&#xa;• レジーム/BCA/フィルター設定" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="config_layer">
          <mxGeometry x="20" y="35" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="symbol_presets" value="SymbolPreset&#xa;(通貨ペア別設定)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;USDJPY/EURJPY等ごとに:&#xa;• スプレッド/SL/TP幅&#xa;• 最大ポジション数/リスク率" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="config_layer">
          <mxGeometry x="250" y="35" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="pm_config" value="PositionManagerConfig&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;ポジション管理の設定:&#xa;• トレーリング/停滞exit&#xa;• 利益保護/部分決済&#xa;• コンセンサスexit閾値" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="config_layer">
          <mxGeometry x="480" y="35" width="200" height="85" as="geometry"/>
        </mxCell>

        <!-- ===== コアレイヤー ===== -->
        <mxCell id="core_layer" value="コアレイヤー — 「共通の言葉（データ型）」" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="1140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="entities" value="Candle(ローソク足) → Signal(売買シグナル) → Position(保有ポジション) → Trade(完了した取引)   |   BotState(ボットの状態)   |   EventBus(イベント通知)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;whiteSpace=wrap;align=center;" vertex="1" parent="core_layer">
          <mxGeometry x="20" y="35" width="1100" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== 矢印（レイヤー間接続）===== -->
        <mxCell id="arrow1" value="シグナル要求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="live_engine" target="tradebot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow2" value="シグナル要求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;fontSize=9;" edge="1" parent="1" source="year_runner" target="tradebot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow3" value="6ステップ実行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="tradebot" target="pipeline">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="entry-flow" name="2. エントリーフロー（SignalPipeline）">
    <mxGraphModel dx="2200" dy="3800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="4200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title2" value="エントリーフロー: SignalPipeline 6ステップ詳細" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide2" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】「新しいポジションを持つかどうか」を決める6段階の&#xa;判断プロセスを上から下へ順番に示しています。&#xa;&#xa;【仕組み】6つのステップを上から順に通過していきます。&#xa;どこか1つでも「ダメ」と判断されると、その時点でHOLD&#xa;（何もしない）が返され、残りのステップはスキップされます。&#xa;全ステップを通過して初めてBUY/SELLシグナルが発行されます。&#xa;&#xa;【形の意味】&#xa;  四角い枠 = 処理ステップ（中に詳細あり）&#xa;  楕円 = 結果（HOLD=何もしない / BUY・SELL=注文する）&#xa;  緑の矢印(OK) = 通過（OKなので次へ）&#xa;  赤の楕円(HOLD) = 中断（NGなのでHOLD）&#xa;&#xa;【具体例: USDJPY H1足でBUYシグナルが出る場合】&#xa;  Step1: リスクOK（日次損失制限内、クールダウン明け）&#xa;  Step2: H1,H4,D1が上向き、M15,M30も上向き&#xa;  Step3: 加重スコア12.5 ≥ 閾値9.0 → BUY方向で合意&#xa;  Step4: BCA方向性エッジ0.72 ≥ 0.55 → 十分な確信&#xa;  Step5: SoftGuardペナルティ0.3 ＜ 0.8 → 通過&#xa;  Step6: SL=25pips, TP=50pips, 0.15lot → BUYシグナル発行" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="480" height="430" as="geometry"/>
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="generate_signal()&#xa;呼び出し" style="ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="60" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 1: RiskCheck -->
        <mxCell id="s1_box" value="Step 1: リスクチェック — 「今、取引していい状態か？」" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="500" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s1_daily" value="日次リセット&#xa;(日付が変わったらPnL/トレード数をゼロに)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s1_box">
          <mxGeometry x="10" y="30" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s1_risk" value="RiskManager.can_trade()&#xa;━━━━━━━━━━━━━━&#xa;5層の安全チェック:&#xa;① サーキットブレーカー（3連敗で一時停止）&#xa;② 急速DD検知（口座が急落していないか）&#xa;③ 日次損失/件数の制限チェック&#xa;④ 前回負けからのクールダウン待ち" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s1_box">
          <mxGeometry x="10" y="80" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s1_session" value="セッション切替チェック&#xa;━━━━━━━━━━━━━━&#xa;東京→ロンドン等の切替直後は&#xa;相場が不安定なので一時待機" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s1_box">
          <mxGeometry x="275" y="80" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s1_hold" value="HOLD&#xa;(取引不可)" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s1_box">
          <mxGeometry x="350" y="30" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 2: TimeframeEval -->
        <mxCell id="s2_box" value="Step 2: 時間足評価 — 「各時間足は何と言っているか？」" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="360" width="570" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="s2_plan" value="モード選択&#xa;→ TradingPlan(UNIVERSAL)&#xa;どのTFが主力/エントリー/&#xa;確認/管理か役割を決定" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;" vertex="1" parent="s2_box">
          <mxGeometry x="10" y="30" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2_eval" value="全TF評価（M1〜D1の8時間足）&#xa;━━━━━━━━━━━━━━━━━━━&#xa;各TFで独立に「買い寄り/売り寄り」を判定:&#xa;• トレンド方向（移動平均の傾き）&#xa;• RSI（買われすぎ/売られすぎ）&#xa;• MACD（勢いの方向）&#xa;• ダイバージェンス（価格とのズレ）&#xa;• EMAクロス（短期/長期線の交差）&#xa;• ストキャスティクス&#xa;→ 各TFごとにTimeframeSignalを生成" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s2_box">
          <mxGeometry x="10" y="95" width="230" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="s2_dynamic" value="動的TF選択&#xa;━━━━━━━━━━━━━━━━━━━&#xa;相場状況に応じて&#xa;「どのTFを重視するか」を&#xa;動的に調整&#xa;（TREND時はH4重視 等）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s2_box">
          <mxGeometry x="255" y="30" width="180" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s2_regime" value="レジーム判定&#xa;━━━━━━━━━━━━━━━━━━━&#xa;今の相場タイプを判定:&#xa;TREND(方向あり)&#xa;RANGE(横ばい)&#xa;LOW_VOL(静か)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s2_box">
          <mxGeometry x="255" y="140" width="160" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s2_htf" value="上位足整合度&#xa;(-1.0〜+1.0)&#xa;上位TFが同方向か確認" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;" vertex="1" parent="s2_box">
          <mxGeometry x="430" y="30" width="130" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 3: Consensus -->
        <mxCell id="s3_box" value="Step 3: コンセンサス — 「全TFの総合判定」" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="650" width="570" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="s3_consensus" value="ModeAwareScoreConsensus.consolidate()&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;① 各TFの「買い/売り」×「役割の重み」×「強度」で&#xa;   buy_scoreとsell_scoreを計算&#xa;② 大きい方が勝ち方向（例: buy=12.5 &gt; sell=3.2 → BUY）&#xa;③ スコアが閾値(9.0)以上か？ → 未満ならHOLD&#xa;④ 50%以上のTFが同方向か？ → 未満ならHOLD&#xa;⑤ 逆方向スコアが60%未満か？ → 超えたらHOLD&#xa;⑥ スコアの偏りが大きすぎないか？&#xa;→ 全て通過したらBUY/SELLを確定" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="s3_box">
          <mxGeometry x="10" y="30" width="350" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="s3_weights" value="TF役割別の重み:&#xa;━━━━━━━━━━━━━━━━━━━&#xa;PRIMARY(主力): 3.0 ← 最重視&#xa;ENTRY(エントリー): 2.5&#xa;CONFIRM(確認): 2.0&#xa;MANAGE(管理): 1.5&#xa;OTHER(その他): 1.0" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s3_box">
          <mxGeometry x="375" y="30" width="180" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="s3_threshold" value="閾値の動的調整&#xa;━━━━━━━━━━━━━━━━━━━&#xa;基本閾値: 9.0&#xa;TREND相場: +1.0（慎重に）&#xa;BB幅が広い: +1.0（慎重に）&#xa;東京17-21時: +0.5（慎重に）&#xa;→ 危険な状況ほど高い閾値 = 厳しい" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s3_box">
          <mxGeometry x="10" y="200" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s3_hold" value="HOLD&#xa;(スコア不足)" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s3_box">
          <mxGeometry x="375" y="155" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 4: EdgeAssessment -->
        <mxCell id="s4_box" value="Step 4: エッジ評価 — 「本当に方向性に確信があるか？」" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="1010" width="490" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="s4_bca" value="BCA方向性エッジ評価&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;全TF間の「方向の一致度」を0〜1で計算&#xa;例: 8TF中7つがBUY → 高いエッジ(0.85)&#xa;例: 4つBUY/4つSELL → 低いエッジ(0.10)&#xa;&#xa;エッジ ＜ min_edge(0.55) → HOLD&#xa;（方向がバラバラなら取引しない）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="s4_box">
          <mxGeometry x="10" y="30" width="290" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s4_fund" value="ファンダメンタル&#xa;方向フィルター&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;LLM分析の方向と不一致なら&#xa;閾値を引き上げて慎重に" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="s4_box">
          <mxGeometry x="315" y="30" width="165" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s4_hold" value="HOLD" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s4_box">
          <mxGeometry x="370" y="130" width="60" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 5: Filter -->
        <mxCell id="s5_box" value="Step 5: フィルター — 「危険な状況を除外」" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="1210" width="670" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="s5_sg" value="SoftGuard.check()&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;スプレッド/セッション/ボラティリティ&#xa;/連敗/MTF不整合/弱トレンド/ファンダ&#xa;→ total_penalty (0〜0.8)&#xa;+ BCAペナルティ加算&#xa;合計0.8以上 → HOLD" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s5_box">
          <mxGeometry x="10" y="30" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s5_filters" value="14個のフィルター（1つでもHitしたらHOLD）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;1. 上位足トレンド不一致: H4/D1の方向とBUY/SELLが逆&#xa;2. SoftGuardブロック: ペナルティ合計 ≥ 0.8&#xa;3. ペナルティ上限超過&#xa;4. トレンド強度が強すぎる（過熱相場を回避）&#xa;5-7. 時間帯フィルター（深夜/早朝/セッション外はNG）&#xa;8. オフタイムのTREND完全ブロック&#xa;9. オフタイム+上位足整合が高すぎる&#xa;10. RANGE/LOW_VOLレジーム別の追加条件&#xa;11. 東京時間の低ペナルティだがスコア不足&#xa;12. MACDスロープが逆方向&#xa;13. 低ATR+TREND（動きが小さいのにトレンド）&#xa;14. 上位足整合が高すぎる→スコア減算" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s5_box">
          <mxGeometry x="10" y="150" width="650" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="s5_hold" value="HOLD&#xa;(フィルタ)" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s5_box">
          <mxGeometry x="560" y="30" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 6: Sizing -->
        <mxCell id="s6_box" value="Step 6: サイジング — 「何ロットで、SL/TPはどこに？」" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="1620" width="490" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="s6_sltp" value="SL/TP計算&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;SL(損切り幅) = primary_tfのSL × 倍率&#xa;  TREND時: SL下限/上限キャップ適用&#xa;TP(利確幅) = SL × RRレシオ(通常2.0)&#xa;例: SL=25pips → TP=50pips" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s6_box">
          <mxGeometry x="10" y="30" width="250" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="s6_sizing" value="ロットサイズ計算&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;口座残高 × リスク率 ÷ SL幅 = ロット&#xa;以下で調整:&#xa;• 連敗時: ロット削減&#xa;• DD時: ロット削減&#xa;• エクスポージャー超過: 制限&#xa;→ 最終ロット (0.01〜max)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s6_box">
          <mxGeometry x="10" y="125" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s6_signal" value="ConsolidatedSignal構築&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;最終的なシグナル情報をまとめる:&#xa;方向(BUY/SELL), SL幅, TP幅,&#xa;ロット数, スコア, レジーム等&#xa;→ これがエントリー注文になる" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="s6_box">
          <mxGeometry x="250" y="30" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s6_blocked" value="HOLD&#xa;(資金管理)" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="s6_box">
          <mxGeometry x="300" y="200" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- ENTRY SIGNAL -->
        <mxCell id="entry_signal" value="BUY/SELL&#xa;シグナル発行！" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="1920" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- 矢印 -->
        <mxCell id="a_start_s1" style="rounded=1;strokeWidth=2;" edge="1" parent="1" source="start" target="s1_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s1_s2" value="OK" style="rounded=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="s1_box" target="s2_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s2_s3" value="OK" style="rounded=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="s2_box" target="s3_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s3_s4" value="OK" style="rounded=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="s3_box" target="s4_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s4_s5" value="OK" style="rounded=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="s4_box" target="s5_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s5_s6" value="OK" style="rounded=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="s5_box" target="s6_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s6_entry" value="全て通過！" style="rounded=1;strokeWidth=3;strokeColor=#82b366;fontColor=#82b366;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s6_box" target="entry_signal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="exit-flow" name="3. エグジットフロー（PositionManager）">
    <mxGraphModel dx="1800" dy="3000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title3" value="エグジットフロー: PositionManager.evaluate() 詳細" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide3" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】保有中のポジションを「いつ決済するか」を決める&#xa;10段階のチェックプロセスを示しています。&#xa;&#xa;【仕組み】上から順に10個のチェックを実行します。&#xa;どれか1つでも「Hit」（条件に合致）したら、即座に&#xa;決済/SL更新等のアクションを実行します。&#xa;全て「Pass」なら、ポジションを継続保有(HOLD)します。&#xa;&#xa;【チェックの優先順位】上ほど優先度が高い:&#xa;  #1-2: SL/TP = 絶対条件（価格が到達したら即決済）&#xa;  #3-4: 停滞/時間 = 利益が出ないまま長時間経過&#xa;  #5-6: シグナル反転/コンセンサス = 相場判断が変わった&#xa;  #7-8: 利益保護(OFF)/早期保護(OFF) = 現在無効&#xa;  #9-10: 部分決済/トレーリング = 利益を伸ばす仕組み&#xa;&#xa;【グレーの項目】(現在デフォルトOFF)は無効化されています。&#xa;バックテストで効果がなかったためOFFにしています。&#xa;&#xa;【具体例: USDJPY BUY 150.00 SL=149.75 TP=150.50】&#xa;  #1 SL: 価格149.75以下? → No → Pass&#xa;  #2 TP: 価格150.50以上? → No → Pass&#xa;  #3 停滞: 90分経過でMFE＜0.5R? → No → Pass&#xa;  ...（全てPass）&#xa;  #10 トレーリング: MFE 1.2R → SLを149.90に引き上げ" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="460" height="500" as="geometry"/>
        </mxCell>

        <!-- 入力 -->
        <mxCell id="pm_input" value="evaluate()が呼ばれる&#xa;（保有中の各ポジションに対して毎回実行）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="400" height="50" as="geometry"/>
        </mxCell>

        <!-- Check 1: SL -->
        <mxCell id="check_sl" value="#1 SLチェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;現在価格がSL(損切りライン)に到達?&#xa;→ Yes: 即決済（損切り）" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- Check 2: TP -->
        <mxCell id="check_tp" value="#2 TPチェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;現在価格がTP(利確ライン)に到達?&#xa;→ Yes: 即決済（利確）" style="rhombus;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="290" y="270" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- Check 3: Stagnation -->
        <mxCell id="check_stag" value="#3 停滞チェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;長時間経過しても利益が出ない場合:&#xa;TREND: 90分で利益＜0.5R → 決済&#xa;RANGE: 120分で利益＜0.5R → 決済&#xa;（ダラダラ保有を防ぐ）" style="rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="260" y="400" width="340" height="110" as="geometry"/>
        </mxCell>

        <!-- Check 4: Time Exit -->
        <mxCell id="check_time" value="#4 時間制限チェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;最大保有時間(max_holding_bars)を超えた?&#xa;→ Yes: 強制決済" style="rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="290" y="550" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- Check 5: Signal Reversal -->
        <mxCell id="check_sigrev" value="#5 シグナル反転チェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;最新シグナルがポジションと逆方向?&#xa;例: BUY保有中にSELLシグナル発生&#xa;→ 含み益がある場合のみ決済" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="260" y="680" width="340" height="100" as="geometry"/>
        </mxCell>

        <!-- Check 6: Consensus Exit -->
        <mxCell id="check_consensus_exit" value="#6 コンセンサスExitチェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;全TFの「総合判断」がポジション逆方向に&#xa;強く傾いた場合 → 決済&#xa;（相場の流れが完全に変わった）" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="260" y="820" width="340" height="100" as="geometry"/>
        </mxCell>

        <!-- Check 7: Profit Reversal (OFF) -->
        <mxCell id="check_profrev" value="#7 利益反転チェック&#xa;(現在デフォルトOFF — 効果なし)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;含み益が反転し始めた場合の決済" style="rhombus;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;whiteSpace=wrap;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="280" y="960" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- Check 8: Early Profit Guard (OFF) -->
        <mxCell id="check_epg" value="#8 早期利益保護&#xa;(現在デフォルトOFF — 効果なし)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;BE付近で停滞時のSL更新/決済" style="rhombus;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;whiteSpace=wrap;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="280" y="1080" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- Check 9: Partial Close -->
        <mxCell id="check_partial" value="#9 部分決済チェック&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;含み益が十分大きくなったら一部を利確:&#xa;MFE ≥ 1R: 50%決済 + SLをBE(建値)に移動&#xa;MFE ≥ 2R: さらに25%決済&#xa;（利益を確保しつつ残りを伸ばす）" style="rhombus;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="250" y="1200" width="360" height="110" as="geometry"/>
        </mxCell>

        <!-- Check 10: Trailing -->
        <mxCell id="check_trailing" value="#10 トレーリングストップ&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;利益が伸びるにつれてSLを引き上げ:&#xa;ATRベースでSLを追従させる&#xa;→ 利益を最大化しつつリスクを限定&#xa;（利益方向に動き続ける限り保有）" style="rhombus;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="250" y="1350" width="360" height="110" as="geometry"/>
        </mxCell>

        <!-- Result: HOLD -->
        <mxCell id="pm_hold" value="HOLD&#xa;(継続保有)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1500" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Exit result -->
        <mxCell id="pm_exit" value="決済 or SL更新&#xa;━━━━━━━━━━━━━━&#xa;FULL_CLOSE(全決済)&#xa;PARTIAL_CLOSE(部分決済)&#xa;UPDATE_SL(SL引き上げ)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="pa1" style="rounded=1;strokeWidth=2;" edge="1" parent="1" source="pm_input" target="check_sl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa2" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_sl" target="check_tp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa3" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_tp" target="check_stag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa4" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_stag" target="check_time">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa5" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_time" target="check_sigrev">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa6" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_sigrev" target="check_consensus_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa7" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_consensus_exit" target="check_profrev">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa8" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_profrev" target="check_epg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa9" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_epg" target="check_partial">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa10" value="Pass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_partial" target="check_trailing">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa11" value="全てPass" style="rounded=1;strokeWidth=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;" edge="1" parent="1" source="check_trailing" target="pm_hold">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Exit arrows -->
        <mxCell id="ex1" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_sl" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex2" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_tp" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex3" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_stag" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex4" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_time" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex5" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_sigrev" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex6" value="Hit!" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=9;" edge="1" parent="1" source="check_consensus_exit" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex9" value="部分利確" style="rounded=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="check_partial" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ex10" value="SL引上げ" style="rounded=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="check_trailing" target="pm_exit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PositionStateMachine -->
        <mxCell id="fsm_title" value="ポジション状態の遷移（PositionStateMachine）" style="text;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="1580" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_desc" value="ポジションは以下の4つの状態を順に遷移します。一方通行で、CLOSEDになったら戻れません。" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1610" width="500" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_open" value="OPEN&#xa;(新規)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1650" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_trail" value="TRAILING&#xa;(追従中)" style="ellipse;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="1650" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_closing" value="CLOSING&#xa;(部分決済中)" style="ellipse;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="1650" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_closed" value="CLOSED&#xa;(完了)" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="1650" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_a1" value="トレーリング開始" style="rounded=1;strokeWidth=1;fontSize=9;" edge="1" parent="1" source="fsm_open" target="fsm_trail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_a2" value="部分決済" style="rounded=1;strokeWidth=1;fontSize=9;" edge="1" parent="1" source="fsm_trail" target="fsm_closing">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_a3" value="全決済" style="rounded=1;strokeWidth=1;fontSize=9;" edge="1" parent="1" source="fsm_closing" target="fsm_closed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_a4" value="SL/TP到達で即決済" style="rounded=1;strokeWidth=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fsm_open" target="fsm_closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="1720"/>
              <mxPoint x="640" y="1720"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="backtest-flow" name="4. バックテスト実行フロー">
    <mxGraphModel dx="1600" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title4" value="バックテスト実行フロー" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide4" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】過去のデータを使って「もしこの戦略で取引していたら&#xa;どうなったか」をシミュレーションする仕組みです。&#xa;&#xa;【なぜ重要？】実際のお金を使う前に、戦略の良し悪しを&#xa;数年分のデータで検証できます。勝率・利益・最大DD等を&#xa;事前に確認してからライブトレードを開始します。&#xa;&#xa;【流れ】&#xa;  ① CLIまたはWebUIからバックテスト開始&#xa;  ② BacktestRunnerがCSVデータをロード&#xa;  ③ 全時間足の指標を事前計算（高速化のため）&#xa;  ④ 年ごとに独立してシミュレーション実行&#xa;     （2020年、2021年...を並列で処理）&#xa;  ⑤ 各年の結果を集約して最終レポート生成&#xa;&#xa;【具体例: USDJPY 2020-2025 バックテスト】&#xa;  入力: data/USDJPY/ のCSVファイル群&#xa;  処理: 6年×8TF → 各足でbot.generate_signal()&#xa;        → simulator.process_candle()&#xa;  出力: 総利益+4,733K, WR 65.1%, PF 1.81&#xa;        月間プラス率 99.0%" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="430" height="420" as="geometry"/>
        </mxCell>

        <!-- CLI / WebUI -->
        <mxCell id="cli" value="バックテスト起動&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;scripts/run_backtest.py (コマンドライン)&#xa;or backtest/adapters/webui.py (WebUI画面)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="350" height="60" as="geometry"/>
        </mxCell>

        <!-- BacktestRunner -->
        <mxCell id="runner" value="BacktestRunner — 全体の司令塔" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="600" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="r_load" value="① DataLoader.load()&#xa;CSVファイルを読み込み、全TFのDataFrameを構築" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;" vertex="1" parent="runner">
          <mxGeometry x="10" y="35" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r_precompute" value="② PrecomputeEngine&#xa;全TFの指標を一括で事前計算&#xa;(結果をParquetでキャッシュ → 2回目以降高速)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;" vertex="1" parent="runner">
          <mxGeometry x="10" y="85" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r_split" value="③ 年別分割 + 並列実行&#xa;2020年/2021年/...を同時に処理（マルチプロセスで高速化）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;" vertex="1" parent="runner">
          <mxGeometry x="10" y="145" width="280" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r_agg" value="⑤ 結果集約 → 全期間の成績レポート作成" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;" vertex="1" parent="runner">
          <mxGeometry x="10" y="200" width="280" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="r_factory" value="StrategyFactory&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;通貨ペアの設定(SymbolPreset)&#xa;をもとにbotとsimulatorの&#xa;設定を自動生成" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="runner">
          <mxGeometry x="320" y="35" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="r_metrics" value="MetricsCalculator&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;勝率/PF/Sharpe/DD/&#xa;月間勝率を計算" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="runner">
          <mxGeometry x="500" y="35" width="90" height="70" as="geometry"/>
        </mxCell>

        <!-- YearRunner -->
        <mxCell id="yr" value="run_unified_year() — 年単位の実行ループ" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="600" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="yr_bot" value="④a. UnifiedTradeBot生成&#xa;年ごとにfreshな(新品の)botを作成（前年の状態が影響しないように）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="yr">
          <mxGeometry x="10" y="35" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="yr_sim" value="④b. TradeSimulator生成（仮想的な取引エンジン、PositionManager統合）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="yr">
          <mxGeometry x="10" y="85" width="380" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="yr_loop" value="④c. メインループ（足ごとに繰り返し）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;全ローソク足を1本ずつ処理:&#xa;  ① Candle(ローソク足)を取り出す&#xa;  ② botに市場データをセット&#xa;  ③ bot.generate_signal() → BUY/SELL/HOLD&#xa;  ④ simulator.process_candle() → 約定処理&#xa;  ⑤ botの状態更新（損益/エクスポージャー）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="yr">
          <mxGeometry x="10" y="130" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="yr_exposure" value="エクスポージャー追跡&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;今どれだけポジションを&#xa;持っているか常に追跡&#xa;（リスク管理に使用）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="yr">
          <mxGeometry x="410" y="145" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- TradeSimulator -->
        <mxCell id="sim_box" value="TradeSimulator.process_candle() — 仮想取引エンジン" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="760" width="600" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="sim_mfe" value="MFE/MAE更新（含み益の最大/含み損の最大を記録）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;" vertex="1" parent="sim_box">
          <mxGeometry x="10" y="35" width="350" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sim_exit" value="Exit判定（PositionManager使用）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;保有中のポジションに対して10個のチェックを実行&#xa;→ 決済/SL更新/継続保有のアクションを返す&#xa;（詳細は「3. エグジットフロー」タブ参照）" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="sim_box">
          <mxGeometry x="10" y="75" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sim_entry" value="Entry判定&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;BUY/SELLシグナル受信 ＆ ポジション枠あり?&#xa;→ Yes: 新規ポジションをオープン" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="sim_box">
          <mxGeometry x="10" y="165" width="350" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sim_spread" value="スプレッドモデル&#xa;━━━━━━━━━━━━━━━━━━━&#xa;固定 or セッション別で&#xa;スプレッド(取引コスト)を&#xa;シミュレーション" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="sim_box">
          <mxGeometry x="420" y="75" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="出力結果&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• trades: 全クローズ済みトレードのリスト&#xa;• metrics: 総利益/勝率/PF/最大DD/Sharpe/月間プラス率&#xa;• monthly_results: 月別の成績内訳" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1060" width="400" height="90" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="ba1" style="rounded=1;strokeWidth=2;" edge="1" parent="1" source="cli" target="runner">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba2" value="年ごと並列" style="rounded=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;" edge="1" parent="1" source="runner" target="yr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba3" value="足ごとループ" style="rounded=1;strokeWidth=2;strokeColor=#d6b656;fontColor=#d6b656;fontSize=10;" edge="1" parent="1" source="yr" target="sim_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba4" style="rounded=1;strokeWidth=2;" edge="1" parent="1" source="sim_box" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="live-flow" name="5. ライブトレード実行フロー">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title5" value="ライブトレード実行フロー" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide5" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】実際のお金を使ってMT5で自動売買する仕組みです。&#xa;&#xa;【バックテストとの違い】&#xa;  バックテスト: 過去データを一気にシミュレーション&#xa;  ライブ: MT5からリアルタイムで価格を取得し、&#xa;          ループし続けて売買シグナルを出す&#xa;  → トレードロジック自体は全く同じものを使用&#xa;&#xa;【主要コンポーネント】&#xa;  EngineManager: 全通貨ペアの親玉&#xa;  LiveTradingEngine: 通貨ペアごとに1つ。&#xa;    ①〜⑥を繰り返すメインループを回す&#xa;  MT5: MetaTrader5（実際の注文を処理する外部ソフト）&#xa;  WebUI: ブラウザで見られるダッシュボード&#xa;&#xa;【具体例: USDJPY BUYシグナル発行時】&#xa;  ① MT5から最新Tick取得（149.95/149.97）&#xa;  ② 全TFのローソク足を更新&#xa;  ③ テクニカル指標を一括計算&#xa;  ④ UnifiedTradeBot → BUYシグナル&#xa;  ⑤ 既存ポジションの決済チェック&#xa;  ⑥ TickEntryOptimizerが有利な価格を待って&#xa;     MT5に発注 → ポジションオープン" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="430" height="450" as="geometry"/>
        </mxCell>

        <!-- EngineManager -->
        <mxCell id="em" value="EngineManager（全通貨ペアの司令塔）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;USDJPY, EURJPY, GBPJPY... 各通貨ペアに&#xa;専用のLiveTradingEngineを割り当てて管理" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="500" height="60" as="geometry"/>
        </mxCell>

        <!-- LiveTradingEngine -->
        <mxCell id="lte" value="LiveTradingEngine — 通貨ペアごとのメインループ" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="800" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="lte_tick" value="① MT5 Tick取得&#xa;リアルタイムの価格を高速で取得し続ける" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="lte">
          <mxGeometry x="10" y="30" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lte_candle" value="② ローソク足更新&#xa;全TF(M1〜D1)の最新ローソク足をMT5から取得" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="lte">
          <mxGeometry x="10" y="85" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lte_indicator" value="③ 指標計算&#xa;全TFのテクニカル指標を一括計算（RSI/MACD等）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;" vertex="1" parent="lte">
          <mxGeometry x="10" y="140" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lte_signal" value="④ シグナル生成（最重要）&#xa;UnifiedTradeBot.generate_signal()&#xa;→ BUY/SELL/HOLDを判定&#xa;（バックテストと全く同じロジック）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="lte">
          <mxGeometry x="10" y="195" width="240" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="lte_pm" value="⑤ ポジション管理&#xa;PositionManager.evaluate()&#xa;保有中ポジションの決済/SL更新&#xa;（10個のチェックを実行）" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="10" y="270" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lte_entry" value="⑥ エントリー実行&#xa;BUY/SELLシグナル ＆ 枠あり&#xa;→ TickEntryOptimizer: 有利なTick価格を待ってから発注" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="10" y="350" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- MT5 execution -->
        <mxCell id="mt5_exec" value="MT5TradeExecutor&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;MT5に注文を送信する窓口:&#xa;• 新規注文(open)&#xa;• 決済(close)&#xa;• SL/TP変更(modify)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="lte">
          <mxGeometry x="320" y="320" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Sync -->
        <mxCell id="pos_sync" value="PositionSync&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;MT5のポジションと内部状態を同期&#xa;（手動クローズの検出にも対応）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="320" y="230" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- Events -->
        <mxCell id="event_pub" value="EventPublisher&#xa;シグナル/ポジション/口座の情報をWebUIにリアルタイム通知" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="590" y="30" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Fundamental -->
        <mxCell id="fund_svc" value="FundamentalService&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;経済指標カレンダー(events.csv)&#xa;LLMによるバイアス分析&#xa;ニュースフィード収集" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="590" y="100" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- Reload -->
        <mxCell id="reload" value="TradeLogicReloader&#xa;設定変更を検知してbotをホットリロード&#xa;（再起動なしでパラメータ変更）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="lte">
          <mxGeometry x="590" y="200" width="190" height="55" as="geometry"/>
        </mxCell>

        <!-- MT5 box -->
        <mxCell id="mt5_box" value="MetaTrader 5&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;外部ソフトウェア:&#xa;• ティック/ローソク足データ提供&#xa;• 注文の実行&#xa;• ポジション/口座情報" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- WebUI box -->
        <mxCell id="webui_box" value="WebUI Dashboard&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;ブラウザで見られる画面:&#xa;• リアルタイムシグナル表示&#xa;• ポジション一覧&#xa;• 口座情報&#xa;• デモ/自動トレード切替" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="680" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="la1" value="通貨ペアごとに1つ" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="em" target="lte">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="la_mt5" value="価格データ/注文" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="mt5_box" target="lte">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="la_webui" value="イベント通知" style="rounded=1;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;fontSize=9;" edge="1" parent="1" source="lte" target="webui_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="data-flow" name="6. データフロー（エンティティ）">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title6" value="データフロー: コアエンティティとデータ変換" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide6" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】データが左から右に変換されていく流れを示しています。&#xa;「生の価格データ」が最終的に「完了した取引記録」になるまでの&#xa;変換ステップです。&#xa;&#xa;【読む方向】左 → 右（矢印の方向に沿って）&#xa;&#xa;【データの旅】&#xa;  CSV/MT5 → Candle(ローソク足)&#xa;  → DataFrame+指標(RSI等を計算)&#xa;  → TimeframeSignal(各TFの判定)&#xa;  → ConsensusResult(全TFの総合判断)&#xa;  → ConsolidatedSignal(最終シグナル+ロット等)&#xa;  → Signal(注文情報) → Position(保有中)&#xa;  → Trade(決済完了の記録)&#xa;&#xa;【具体例: 1つのトレードの一生】&#xa;  CSV 149.50/149.80/149.40/149.70&#xa;  → Candle{o=149.50,h=149.80,l=149.40,c=149.70}&#xa;  → RSI=35(売られすぎ), MACD上向き&#xa;  → H1:BUY(7.5), H4:BUY(5.2), D1:SELL(3.1)&#xa;  → Consensus: BUY score=12.7 ≥ 9.0&#xa;  → Signal: BUY 149.70 SL=149.45 TP=150.20&#xa;  → Position: ticket#12345 0.15lot&#xa;  → Trade: +25pips 利確(TP到達)" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="460" height="480" as="geometry"/>
        </mxCell>

        <!-- Data sources -->
        <mxCell id="csv" value="CSV/MT5&#xa;(価格データ)" style="shape=cylinder3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- Candle -->
        <mxCell id="candle_ent" value="Candle（ローソク足）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;始値(open), 高値(high),&#xa;安値(low), 終値(close),&#xa;時刻(time), 出来高" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="180" height="85" as="geometry"/>
        </mxCell>

        <!-- DataFrame + Indicators -->
        <mxCell id="df_indicators" value="DataFrame + テクニカル指標&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;ローソク足にテクニカル指標を付加:&#xa;SMA, EMA, RSI, MACD, ATR,&#xa;ボリンジャーバンド, ストキャスティクス&#xa;+ レジーム判定結果" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="200" y="185" width="210" height="100" as="geometry"/>
        </mxCell>

        <!-- TimeframeSignal -->
        <mxCell id="tf_sig" value="TimeframeSignal（TF別シグナル）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;各時間足の「買い/売り」判定:&#xa;• direction: BUY/SELL/HOLD&#xa;• buy_strength / sell_strength&#xa;• SL/TP幅(pips)&#xa;• スコア内訳" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="230" height="115" as="geometry"/>
        </mxCell>

        <!-- ConsensusResult -->
        <mxCell id="consensus_res" value="ConsensusResult（総合判定）&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;全TFをまとめた最終判断:&#xa;• direction: BUY/SELL/HOLD&#xa;• score: 加重スコア&#xa;• threshold: 閾値&#xa;• aligned_tfs: 同方向のTF一覧&#xa;• reasoning: 判断理由（日本語）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="220" width="230" height="140" as="geometry"/>
        </mxCell>

        <!-- ConsolidatedSignal -->
        <mxCell id="consol_sig" value="ConsolidatedSignal（最終シグナル）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;パイプラインの最終出力。全情報を含む:&#xa;方向, SL/TP幅, ロット数, スコア,&#xa;レジーム, ペナルティ, トレンド強度 等" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="340" height="90" as="geometry"/>
        </mxCell>

        <!-- Signal -->
        <mxCell id="signal_ent" value="Signal（注文用シグナル）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;MT5/Simulatorに渡す簡潔な注文情報:&#xa;BUY/SELL, 価格, SL, TP, ロット, 信頼度" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="190" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- Position -->
        <mxCell id="pos_ent" value="Position（保有中のポジション）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;現在持っているポジション:&#xa;チケット番号, 通貨ペア, BUY/SELL, ロット数,&#xa;建値, SL, TP, 含み損益, 状態(OPEN→CLOSED)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="290" width="340" height="90" as="geometry"/>
        </mxCell>

        <!-- Trade -->
        <mxCell id="trade_ent" value="Trade（完了した取引記録）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;決済済みの取引結果:&#xa;建値, 決済価格, 損益(pips), 決済理由,&#xa;MFE(含み益最大), MAE(含み損最大)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="340" height="90" as="geometry"/>
        </mxCell>

        <!-- BotState -->
        <mxCell id="botstate" value="BotState（ボットの状態）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;ボットが「今どんな状態か」を記録:&#xa;• 口座残高 / 最高残高 / DD率&#xa;• 連勝数 / 連敗数&#xa;• 本日の損益 / 本日のトレード数&#xa;• 現在のエクスポージャー（保有lot合計）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;不変(frozen)オブジェクト:&#xa;更新時は新しいコピーを作成" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="400" width="200" height="170" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="da1" value="読込" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="csv" target="candle_ent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da2" value="指標計算" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="candle_ent" target="df_indicators">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da3" value="TF別評価" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="df_indicators" target="tf_sig">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da4" value="コンセンサス" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="tf_sig" target="consensus_res">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da5" value="パイプライン出力" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="consensus_res" target="consol_sig">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="290"/>
              <mxPoint x="750" y="115"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="da6" value="変換" style="rounded=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="consol_sig" target="signal_ent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da7" value="エントリー" style="rounded=1;strokeWidth=2;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="signal_ent" target="pos_ent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da8" value="決済" style="rounded=1;strokeWidth=2;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="pos_ent" target="trade_ent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="da10" value="状態更新" style="rounded=1;strokeWidth=2;fontSize=9;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="trade_ent" target="botstate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="webui-backend" name="7. WebUIデータフロー（バックエンド）">
    <mxGraphModel dx="2400" dy="3800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="4000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title7" value="WebUI データフロー（バックエンド → フロントエンド）" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- 読み方ガイド -->
        <mxCell id="guide7" value="このダイアグラムの読み方&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【目的】WebUIの各フィールドが「どこからデータを取得し」&#xa;「どの頻度で更新されるか」を示しています。&#xa;&#xa;【2つのデータ取得方法】&#xa;  REST API（青い矢印）: 30秒ごとにサーバーに問い合わせ&#xa;    → 確実だが遅い。フォールバック用&#xa;  WebSocket（赤い矢印）: サーバーから即座にプッシュ通知&#xa;    → 高速。価格更新は毎tick（サブ秒）で届く&#xa;&#xa;【データの旅】&#xa;  MT5 → LiveTradingEngine → EventBus&#xa;   ├→ EventBridge → WebSocket → フロントエンド（即座）&#xa;   └→ REST API → 30秒ポーリング → フロントエンド&#xa;&#xa;【WebSocket切断時の安全装置】&#xa;  WebSocketが切れると、自動的に10秒間隔の&#xa;  RESTポーリングに切り替わります。&#xa;  再接続すると即座にWebSocketに戻ります。&#xa;&#xa;【具体例: 価格が動いた時】&#xa;  MT5でUSDJPY 149.95→150.00に変動&#xa;  → Engine: price.updated イベント発火&#xa;  → EventBridge: PRICE_UPDATE をWebSocketに配信&#xa;  → dashboard.js: ChartManager.updateLastBar(150.00)&#xa;  → 画面のチャートが即座に更新される" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="470" height="480" as="geometry"/>
        </mxCell>

        <!-- ===== バックエンド データソース層 ===== -->
        <mxCell id="backend_layer" value="バックエンド データソース" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="1300" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="mt5_src" value="MetaTrader 5&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• ティック価格（毎秒複数回）&#xa;• ローソク足（全TF）&#xa;• ポジション情報&#xa;• 口座情報（残高/証拠金）&#xa;• 注文実行結果" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="backend_layer">
          <mxGeometry x="10" y="30" width="190" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="engine_src" value="LiveTradingEngine&#xa;(通貨ペアごとに1つ)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• last_analysis: 最新分析結果&#xa;  (方向/スコア/レジーム/ペナルティ)&#xa;• cached_positions: 保有ポジション&#xa;• signal_history: シグナル履歴&#xa;• account_info: 口座情報キャッシュ&#xa;• get_candles(): ローソク足データ&#xa;• get_indicators(): 指標データ" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="backend_layer">
          <mxGeometry x="220" y="30" width="230" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="enginemgr_src" value="EngineManager&#xa;(全通貨ペアの統合管理)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• all_cached_positions: 全ペア合算&#xa;• account_info: 口座情報（統合）&#xa;• symbols: アクティブ通貨ペア一覧&#xa;• symbol_auto_trade_states&#xa;• symbol_demo_mode_states" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="backend_layer">
          <mxGeometry x="470" y="30" width="220" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="eventbus_src" value="EventBus&#xa;(イベント駆動パイプ)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• price.updated（毎tick）&#xa;• tick.completed（分析完了時）&#xa;• signal.generated（シグナル発行時）&#xa;• position.opened/closed&#xa;• news.received&#xa;• calendar.updated&#xa;• logic.reloaded/change_detected" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="backend_layer">
          <mxGeometry x="710" y="30" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="db_src" value="DB (TradeRecord)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• トレード履歴&#xa;• 統計集計（PF/WR等）&#xa;• 日次/週次/月次損益" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="backend_layer">
          <mxGeometry x="950" y="30" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="market_svc" value="MarketService&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;• daily/weekly/monthly_pnl&#xa;• win_rate, today_trades&#xa;• profit_factor 計算" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;align=left;" vertex="1" parent="backend_layer">
          <mxGeometry x="1150" y="30" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- MT5 → Engine 矢印 -->
        <mxCell id="mt5_to_engine" value="データ取得" style="rounded=1;strokeWidth=2;strokeColor=#b85450;fontSize=9;" edge="1" parent="backend_layer" source="mt5_src" target="engine_src">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="engine_to_mgr" value="集約" style="rounded=1;strokeWidth=2;strokeColor=#d79b00;fontSize=9;" edge="1" parent="backend_layer" source="engine_src" target="enginemgr_src">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="engine_to_bus" value="イベント発火" style="rounded=1;strokeWidth=2;strokeColor=#d6b656;fontSize=9;" edge="1" parent="backend_layer" source="engine_src" target="eventbus_src">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== 配信レイヤー（REST + WebSocket） ===== -->
        <mxCell id="delivery_layer" value="配信レイヤー（REST API + WebSocket）" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="860" width="1300" height="380" as="geometry"/>
        </mxCell>

        <!-- REST API -->
        <mxCell id="rest_group" value="REST API（30秒ポーリング）— 確実だが遅い" style="swimlane;startSize=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="delivery_layer">
          <mxGeometry x="10" y="30" width="630" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="api_dashboard" value="/api/v1/dashboard&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;口座情報（残高/証拠金/維持率）&#xa;損益（日次/週次/月次/全体）&#xa;勝率/本日トレード数/PF&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: EngineManager + MarketService" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="10" y="25" width="200" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="api_positions" value="/api/v1/positions&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;全オープンポジション一覧:&#xa;チケット/シンボル/方向/ロット/&#xa;建値/SL/TP/含み損益/保有時間&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: Engine.cached_positions" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="220" y="25" width="190" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="api_analysis" value="/api/v1/signals/analysis&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;最新分析結果:&#xa;方向/スコア/信頼度/閾値&#xa;レジーム/トレンド強度&#xa;ペナルティ/TF別スコア・方向&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: Engine.last_analysis" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="420" y="25" width="200" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="api_trades" value="/api/v1/trades&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;トレード履歴 + 統計:&#xa;エントリー/エグジット日時&#xa;損益/pips/決済理由&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: DB (TradeRecord)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="10" y="140" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="api_mode" value="/api/v1/trading/mode&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;接続状態/モード(ライブ/デモ)&#xa;自動取引ON/OFF&#xa;シンボル別自動取引/デモ状態&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: EngineManager" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="220" y="140" width="190" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="api_candles" value="/api/v1/candles/{symbol}/{tf}&#xa;/api/v1/indicators/{symbol}/{tf}&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;ローソク足データ(OHLCV)&#xa;指標時系列(EMA/BB/RSI等)&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;取得元: Engine / pandas_ta計算" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="420" y="140" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="api_control" value="操作API（ユーザーアクション時のみ）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;POST /trading/mt5/connect — MT5接続開始&#xa;POST /trading/mt5/disconnect — MT5切断&#xa;POST /trading/auto-trade — 自動取引切替&#xa;POST /trading/symbol-auto-trade — シンボル別切替&#xa;POST /trading/reload-logic — ロジックホットリロード&#xa;POST /positions/{ticket}/close — ポジション手動決済" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="rest_group">
          <mxGeometry x="10" y="250" width="610" height="80" as="geometry"/>
        </mxCell>

        <!-- WebSocket -->
        <mxCell id="ws_group" value="WebSocket（リアルタイム即座）— 高速プッシュ" style="swimlane;startSize=22;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="delivery_layer">
          <mxGeometry x="660" y="30" width="630" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="ws_bridge" value="EventBridge&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;EventBus → WebSocket変換:&#xa;Engine内のイベントを&#xa;WebSocketメッセージに変換して&#xa;接続中のブラウザに配信" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;fontStyle=1;" vertex="1" parent="ws_group">
          <mxGeometry x="10" y="25" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ws_price" value="PRICE_UPDATE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: 毎tick（サブ秒）&#xa;内容: bid/ask価格, 時刻&#xa;用途: チャートの最後の足を&#xa;      リアルタイム更新&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;元イベント: price.updated" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="220" y="25" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ws_tick" value="TICK_UPDATE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: 分析完了ごと&#xa;内容: 分析結果 + 口座情報&#xa;      + ポジション情報を一括&#xa;用途: 分析パネル/メトリクス/&#xa;      ポジション一覧を一括更新&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;元イベント: tick.completed" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="420" y="25" width="200" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="ws_position" value="POSITION_UPDATE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: ポジション開閉時のみ&#xa;内容: 開いた/閉じた情報&#xa;用途: ポジション一覧を即再取得&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;元: position.opened/closed" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="10" y="130" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="ws_signal" value="SIGNAL_UPDATE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: シグナル発行時のみ&#xa;内容: BUY/SELL/HOLDシグナル詳細&#xa;用途: シグナル履歴に追加&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;元: signal.generated" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="220" y="160" width="190" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="ws_news" value="NEWS/CALENDAR_UPDATE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: ニュース受信/カレンダー更新時&#xa;内容: ニュース本文/経済指標情報&#xa;用途: ファンダメンタルウィジェット&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;元: news.received/calendar.updated" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="420" y="160" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="ws_logic" value="LOGIC_RELOAD / CHANGE_DETECTED&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;頻度: 設定変更検知/リロード時&#xa;内容: リロード成功/失敗/変更ファイル&#xa;用途: リロードボタン状態更新" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="10" y="245" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ws_channels" value="WebSocketチャネル&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;dashboard: メイン画面用（全イベント受信）&#xa;signals: シグナル専用ページ用&#xa;market:{symbol}: シンボル別チャート用" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="ws_group">
          <mxGeometry x="280" y="265" width="340" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== フロントエンド UIフィールド層 ===== -->
        <mxCell id="frontend_layer" value="フロントエンド UIフィールド（dashboard.html + dashboard.js）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1270" width="1300" height="520" as="geometry"/>
        </mxCell>

        <!-- DataFlowManager -->
        <mxCell id="dfm" value="DataFlowManager（フロントエンドのデータハブ）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;REST APIの結果とWebSocketのプッシュデータを統合して各UIコンポーネントに配信するpub/subハブ&#xa;チャネル: dashboard / positions / trades / analysis / symbol / tradingMode" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;align=center;fontStyle=1;" vertex="1" parent="frontend_layer">
          <mxGeometry x="10" y="30" width="1280" height="50" as="geometry"/>
        </mxCell>

        <!-- Metrics パネル -->
        <mxCell id="ui_metrics" value="メトリクスパネル（MetricsStrip）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;残高 ← dashboard.account.balance [REST30秒 + WS即座]&#xa;有効証拠金 ← dashboard.account.equity [REST30秒]&#xa;証拠金維持率 ← dashboard.account.margin_level [REST30秒 + WS即座]&#xa;余剰証拠金 ← dashboard.account.free_margin [REST30秒 + WS即座]&#xa;本日損益 ← dashboard.daily_pnl [REST30秒]&#xa;週間損益 ← dashboard.weekly_pnl [REST30秒]&#xa;月間損益 ← dashboard.monthly_pnl [REST30秒]&#xa;勝率 ← dashboard.win_rate [REST30秒]&#xa;PF ← trades.summary.profit_factor [REST30秒]&#xa;本日トレード数 ← dashboard.today_trades [REST30秒]&#xa;ポジション数 ← positions.length [REST30秒 + WS即座]&#xa;未決済損益 ← sum(positions.unrealized_pnl) [REST30秒 + WS即座]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="10" y="90" width="420" height="190" as="geometry"/>
        </mxCell>

        <!-- Analysis パネル -->
        <mxCell id="ui_analysis" value="分析パネル（AnalysisPanel）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;方向(BUY/SELL) ← analysis.direction [REST30秒 + WS即座]&#xa;スコア ← analysis.consensus_score [REST30秒 + WS即座]&#xa;信頼度 ← analysis.confidence [REST30秒 + WS即座]&#xa;エントリー閾値 ← analysis.entry_threshold [REST30秒 + WS即座]&#xa;レジーム ← analysis.regime [REST30秒 + WS即座]&#xa;トレンド強度 ← analysis.trend_strength [REST30秒 + WS即座]&#xa;HTF整合度 ← analysis.htf_alignment [REST30秒 + WS即座]&#xa;ペナルティ合計 ← analysis.penalty_total [REST30秒 + WS即座]&#xa;TF別スコア ← analysis.tf_scores{M5:3.2, H1:5.1...} [REST30秒 + WS即座]&#xa;TF別方向 ← analysis.tf_directions{M5:BUY, H1:BUY...} [REST30秒 + WS即座]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="450" y="90" width="420" height="165" as="geometry"/>
        </mxCell>

        <!-- Position パネル -->
        <mxCell id="ui_positions" value="ポジションパネル（PositionPanel）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;チケット ← positions[].ticket [REST30秒 + WS即座]&#xa;シンボル ← positions[].symbol [REST30秒 + WS即座]&#xa;方向(BUY/SELL) ← positions[].signal_type [REST30秒 + WS即座]&#xa;ロット数 ← positions[].volume [REST30秒 + WS即座]&#xa;建値 ← positions[].entry_price [REST30秒 + WS即座]&#xa;現在価格 ← positions[].current_price [REST30秒 + WS即座]&#xa;含み損益 ← positions[].unrealized_pnl [REST30秒 + WS即座]&#xa;SL/TP ← positions[].stop_loss/take_profit [REST30秒 + WS即座]&#xa;保有時間 ← positions[].elapsed_minutes [REST30秒 + WS即座]&#xa;決済ボタン → POST /positions/{ticket}/close [ユーザー操作]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="10" y="290" width="420" height="165" as="geometry"/>
        </mxCell>

        <!-- Chart -->
        <mxCell id="ui_chart" value="チャート（ChartManager）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;ローソク足 ← /candles/{symbol}/{tf} [REST30秒]&#xa;最後の足(リアルタイム) ← WS PRICE_UPDATE [毎tick・サブ秒]&#xa;EMA(12/26/50/200) ← /indicators/{s}/{tf}/series [REST60秒]&#xa;ボリンジャーバンド ← /indicators/{s}/{tf}/series [REST60秒]&#xa;RSI ← /indicators/{s}/{tf}/series [REST60秒]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="890" y="90" width="400" height="100" as="geometry"/>
        </mxCell>

        <!-- Trades パネル -->
        <mxCell id="ui_trades" value="トレード履歴パネル（TradesPanel）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;エントリー/エグジット日時 ← trades[].opened_at/closed_at [REST30秒]&#xa;損益(pips) ← trades[].profit_loss_pips [REST30秒]&#xa;損益(金額) ← trades[].profit_loss [REST30秒]&#xa;決済理由 ← trades[].exit_reason [REST30秒]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;※DBから取得。WebSocketでの即座更新なし（POSITION_UPDATE受信時に再取得）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="450" y="290" width="420" height="115" as="geometry"/>
        </mxCell>

        <!-- Header/Control -->
        <mxCell id="ui_header" value="ヘッダー/接続コントロール（TradingControl）&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;MT5接続状態 ← tradingMode.connected [REST30秒]&#xa;モード(ライブ/デモ) ← tradingMode.mode [REST30秒]&#xa;自動取引ON/OFF ← tradingMode.auto_trade [REST30秒]&#xa;シンボル一覧 ← tradingMode.symbols [REST30秒]&#xa;シンボル別自動取引 ← tradingMode.symbol_auto_trade [REST30秒]&#xa;接続/切断ボタン → POST /trading/mt5/connect or disconnect&#xa;リロードボタン → POST /trading/reload-logic" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="890" y="200" width="400" height="125" as="geometry"/>
        </mxCell>

        <!-- Fundamental -->
        <mxCell id="ui_fundamental" value="ファンダメンタルウィジェット&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;次の重要指標までの時間 ← WS CALENDAR_UPDATE [イベント時]&#xa;最新ニュース ← WS NEWS_UPDATE [ニュース受信時]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;whiteSpace=wrap;align=left;" vertex="1" parent="frontend_layer">
          <mxGeometry x="890" y="340" width="400" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== フォールバック説明 ===== -->
        <mxCell id="fallback_box" value="WebSocket切断時のフォールバック機構&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;通常時: WebSocket接続中 → WS即座更新 + REST 30秒ポーリング（バックアップ）&#xa;WS切断時: 自動的に10秒間隔のRESTポーリングに切り替え（analysis + positions + tradingMode）&#xa;WS復旧時: 即座にWebSocketに戻り、10秒ポーリングは停止" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1810" width="1300" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== 更新頻度まとめ ===== -->
        <mxCell id="freq_summary" value="更新頻度まとめ&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;&#xa;【毎tick（サブ秒）】チャートの最後の足の価格 ← PRICE_UPDATE&#xa;【分析完了ごと】分析パネル + 口座情報 + ポジション一括 ← TICK_UPDATE&#xa;【イベント発生時】ポジション開閉 ← POSITION_UPDATE / シグナル発行 ← SIGNAL_UPDATE&#xa;【30秒ごと(REST)】メトリクス全体 / トレード履歴 / 接続状態 ← REST APIポーリング&#xa;【60秒ごと(REST)】チャート指標オーバーレイ(EMA/BB/RSI) ← indicators/series API&#xa;【低頻度】ニュース受信時 / 経済指標更新時 / ロジックリロード時" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1900" width="1300" height="150" as="geometry"/>
        </mxCell>

        <!-- レイヤー間の矢印 -->
        <mxCell id="backend_to_rest" value="HTTPリクエスト" style="rounded=1;strokeWidth=3;strokeColor=#6c8ebf;fontSize=10;fontColor=#6c8ebf;" edge="1" parent="1" source="backend_layer" target="rest_group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="backend_to_ws" value="イベントプッシュ" style="rounded=1;strokeWidth=3;strokeColor=#b85450;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="eventbus_src" target="ws_bridge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rest_to_frontend" value="30秒ポーリング" style="rounded=1;strokeWidth=3;strokeColor=#6c8ebf;fontSize=10;fontColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="delivery_layer" target="dfm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ws_to_frontend" value="即座プッシュ" style="rounded=1;strokeWidth=3;strokeColor=#b85450;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="ws_group" target="dfm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
