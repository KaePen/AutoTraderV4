# データベース接続URL
# Supabase PostgreSQL URLを設定してください
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# SQLite（デフォルト、開発・テスト用）
# DATABASE_URL=sqlite:///data/autotrader.db

# 認証設定（WebUI ログイン）
# AUTOTRADER_WEB_ADMIN_PASSWORD=your_secure_password_here
# AUTOTRADER_WEB_JWT_SECRET_KEY=your_random_secret_key_here  # 省略時は起動毎に自動生成
# AUTOTRADER_WEB_JWT_EXPIRE_MINUTES=1440  # 24時間（デフォルト）
