# ===== AutoTraderV4 環境変数 =====

# データベース（Supabase Direct Connection）
# Supabase ダッシュボード > Settings > Database > Connection string (URI) からコピー
# 例: postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/autotrader.db

# ローカルDB（ポジション管理状態 — SQLite固定）
LOCAL_DATABASE_URL=sqlite:///data/local_state.db

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# リスク管理
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_COUNT=2
MIN_MARGIN_RATIO=150.0

# ログ
LOG_LEVEL=INFO
