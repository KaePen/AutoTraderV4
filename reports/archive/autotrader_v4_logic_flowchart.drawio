  <!-- ================================================================== -->
  <!-- Page 1: System Overview                                             -->
  <!-- ================================================================== -->
  <diagram id="overview" name="1. システム全体概要">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="t1" value="&lt;b&gt;AutoTraderV4 トレードロジック全体フロー&lt;/b&gt;" style="text;html=1;fontSize=24;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== Market Data Input ========== -->
        <mxCell id="md1" value="&lt;b&gt;市場データ入力&lt;/b&gt;&lt;br&gt;M1, M5, M15, M30,&lt;br&gt;H1, H4, H8, D1&lt;br&gt;(8時間足)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- ========== Phase 1: Constraints ========== -->
        <mxCell id="cg1" value="&lt;b&gt;Phase 1: 制約チェック&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;HardGuard (8条件)&lt;br&gt;・証拠金維持率 &gt; 150%&lt;br&gt;・日次損失 &lt; 5%&lt;br&gt;・ポジション数上限&lt;br&gt;・取引時間（週末禁止）&lt;br&gt;・データ品質&lt;br&gt;・高インパクトニュース&lt;br&gt;・セッション切替待機&lt;br&gt;・ファンダメンタル注意度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="240" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- ========== Phase 2: Signal Generation ========== -->
        <mxCell id="sg1" value="&lt;b&gt;Phase 2: シグナル生成パイプライン&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;Step 1: リトレース待機チェック&lt;br&gt;Step 2: リスク管理チェック&lt;br&gt;Step 3: 全TF評価 + レジーム検出&lt;br&gt;Step 4: コンセンサス統合&lt;br&gt;Step 5: BCA + フィルタ + SL/TP&lt;br&gt;Step 6: ポジションサイジング&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- ========== Phase 3: Entry Execution ========== -->
        <mxCell id="ee1" value="&lt;b&gt;Phase 3: エントリー実行&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;・エントリー価格計算&lt;br&gt;　(close ± spread/2 ± slippage)&lt;br&gt;・ロット数決定&lt;br&gt;・証拠金チェック&lt;br&gt;・SL/TP価格設定&lt;br&gt;・PositionManager登録&lt;br&gt;&lt;br&gt;[ライブ] M1ティック最適化&lt;br&gt;　スプレッド + モメンタム評価&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- ========== Phase 4: Position Management ========== -->
        <mxCell id="pm1" value="&lt;b&gt;Phase 4: ポジション管理&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;10段階の評価（優先度順）:&lt;br&gt;1. SL到達チェック&lt;br&gt;2. 部分利確 (1R/2R/0.5R)&lt;br&gt;3. TP到達チェック&lt;br&gt;4. 利益反転ガード&lt;br&gt;5. 早期利益ガード (EPG)&lt;br&gt;6. 停滞Exit + SL引き締め&lt;br&gt;7. 時間決済&lt;br&gt;8. シグナル反転&lt;br&gt;9. コンセンサス逆転Exit&lt;br&gt;10. トレーリング更新&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="240" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- ========== Phase 5: Risk Management ========== -->
        <mxCell id="rm1" value="&lt;b&gt;Phase 5: 資金管理&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;・ロット計算 (equity × risk% / SL)&lt;br&gt;・レジーム調整 (TREND 1.0x / RANGE 0.7x)&lt;br&gt;・DD調整 (0.8%警告 / 1.5%減額)&lt;br&gt;・連敗調整 (2連敗から減額)&lt;br&gt;・資金フロア (30%で停止)&lt;br&gt;・エクスポージャー3重制限&lt;br&gt;・サーキットブレーカー&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1580" y="240" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="md1" target="cg1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="PASS" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="cg1" target="sg1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="BUY/SELL" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sg1" target="ee1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="ポジション&lt;br&gt;オープン" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ee1" target="pm1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="rm1" target="sg1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1710" y="180"/><mxPoint x="630" y="180"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a5l" value="ロット・DD制御" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="a5">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- BLOCK arrow from HardGuard -->
        <mxCell id="a6" value="&lt;font color='#CC0000'&gt;&lt;b&gt;BLOCK&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#CC0000;dashed=1;" edge="1" source="cg1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="hold1" value="HOLD&lt;br&gt;(エントリー見送り)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="190" y="500" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- HOLD from Signal -->
        <mxCell id="a7" value="&lt;font color='#CC0000'&gt;&lt;b&gt;HOLD&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#CC0000;dashed=1;" edge="1" source="sg1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="hold2" value="HOLD&lt;br&gt;(閾値未達/フィルタ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="550" y="500" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== Legend ========== -->
        <mxCell id="leg" value="&lt;b&gt;凡例&lt;/b&gt;&lt;hr&gt;&lt;font size='1'&gt;🔴 制約・ガード (Phase 1)&lt;br&gt;🟢 シグナル生成 (Phase 2)&lt;br&gt;🟡 エントリー実行 (Phase 3)&lt;br&gt;🟣 ポジション管理 (Phase 4)&lt;br&gt;⚪ 資金管理 (Phase 5)&lt;br&gt;--- 破線: BLOCK/HOLD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1600" y="500" width="200" height="140" as="geometry"/>
        </mxCell>

        <!-- ========== 1足ループ ========== -->
        <mxCell id="loop" value="&lt;b&gt;メインループ（1足ごと）&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="630" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- Main Loop Steps -->
        <mxCell id="ml1" value="① 月変わり検出&lt;br&gt;月末PnL計算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml2" value="② エクスポージャー&lt;br&gt;同期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml3" value="③ エクイティ記録&lt;br&gt;急速DD検知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml4" value="④ サーキット&lt;br&gt;ブレーカー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml5" value="⑤ ファンダメンタル&lt;br&gt;指標前スキップ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml6" value="⑥ シグナル生成&lt;br&gt;generate_signal()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml7" value="⑦ エントリー判定&lt;br&gt;process_candle()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml8" value="⑧ PM: Exit評価&lt;br&gt;SL/TP/Trail更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="690" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ml9" value="⑨ DD/PnL&lt;br&gt;記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="690" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Loop arrows -->
        <mxCell id="la1" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml1" target="ml2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="la2" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml2" target="ml3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="la3" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml3" target="ml4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="la4" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml4" target="ml5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="la5" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml5" target="ml6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="la6" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml6" target="ml7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
