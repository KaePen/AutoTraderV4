        <mxCell id="la8" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="ml8" target="ml9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Loop back -->
        <mxCell id="la9" value="次の足へ" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;curved=1;" edge="1" source="ml9" target="ml1" parent="1">
